# Copy this file to .env.local and fill in real values.
# The app runs fine without these (anonymous, local progress only) — they are
# needed to enable accounts and cloud sync.

# Neon Postgres connection string (Neon dashboard → Connection Details).
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET=your-generated-secret

# Google OAuth credentials (Google Cloud Console → OAuth 2.0 Client).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Optional — only needed in production so Auth.js knows its public URL.
# AUTH_URL=https://your-domain.com
